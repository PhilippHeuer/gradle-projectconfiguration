                {
                  "name": "WRAPPER_VERIFICATION"
                },
                {
                  "name": "MAVEN_VERSION"
                }
              ],
              "executables": [
                {
                  "name": "java",
                  "constraint": "\u003e= 21.0.0-0"
                }
              ],
              "network": [
                "repo.maven.apache.org:443",
                "repo1.maven.org:443",
                "kotlinlang.org:443",
