            "name": "gradle-build [gradle-projectconfiguration]",
            "slug": "gradle-build-gradle-projectconfiguration",
            "stage": "build",
            "scope": "module",
            "action": "builtin://actions/gradle-build",
            "module": "gradle-build-gradle-kts",
            "module-dir": ".",
